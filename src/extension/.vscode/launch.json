{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/src/extension"
      ],
      "outFiles": ["${workspaceFolder}/src/extension/dist/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
