{
  "name": "ohno",
  "displayName": "Oʰ(nᵒ) — Algorithmic Complexity",
  "description": "Inline Big-O time and space estimates for C# functions, with confidence, named approaches, and selection-scoped analysis.",
  "version": "0.1.1",
  "publisher": "ohno-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jitterbox/Ohno.git",
    "directory": "src/extension"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Education"
  ],
  "keywords": [
    "big-o",
    "complexity",
    "performance",
    "analysis",
    "csharp"
  ],
  "activationEvents": [
    "onLanguage:csharp",
    "onView:ohno.summary",
    "onView:ohno.derivation"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "Oʰ(nᵒ)",
        "properties": {
          "ohno.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable Ohno complexity annotations."
          },
          "ohno.analysis.tier": {
            "type": "string",
            "enum": [
              "fast",
              "deep"
            ],
            "default": "fast",
            "description": "Reserved. Automatic analysis always uses the fast tier; deep analysis runs only via 'Ohno: Run Deep Analysis'.",
            "markdownDeprecationMessage": "Automatic analysis is always fast. Use the 'Ohno: Run Deep Analysis' command for solution-wide analysis."
          },
        "ohno.annotations.showInline": {
          "type": "boolean",
          "default": true,
          "description": "Show complexity estimates as inline end-of-line annotations in the editor."
        },
        "ohno.annotations.mode": {
          "type": "string",
          "enum": [
            "inline",
            "codelens",
            "off"
          ],
          "default": "inline",
          "description": "How complexity annotations are displayed: inline end-of-line decorations, CodeLens above functions, or off."
        },
        "ohno.annotations.nestingDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 6,
          "description": "How many block-nesting levels below the function receive their own subtotal annotations (0 = function totals only)."
        },
        "ohno.annotations.showSpace": {
          "type": "boolean",
          "default": true,
          "description": "Include auxiliary space complexity in annotations."
        },
        "ohno.annotations.showConfidence": {
          "type": "boolean",
          "default": true,
          "description": "Include the confidence indicator in annotations."
        },
        "ohno.performance.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "description": "Debounce delay before re-analyzing after edits."
        },
        "ohno.performance.maxFileSizeKb": {
          "type": "number",
          "default": 500,
          "description": "Skip analysis for files larger than this size (KB). 0 disables the limit."
        },
        "ohno.csharp.analyzerPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the Ohno C# analyzer server executable. Empty uses the bundled server."
        },
        "ohno.server.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "warn",
          "description": "Log level for the analyzer server (written to the Ohno output channel)."
        }
        }
      },
      {
        "title": "Oʰ(nᵒ) > Languages",
        "properties": {
          "ohno.languages.csharp": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "markdownDescription": "Analyze **C#** files. C# is the only built-in language."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "ohno.runDeepAnalysis",
        "title": "Run Deep Analysis",
        "category": "Oʰ(nᵒ)",
        "icon": "$(zap)"
      },
      {
        "command": "ohno.showDerivation",
        "title": "Show Complexity Derivation",
        "category": "Oʰ(nᵒ)",
        "icon": "$(list-tree)"
      },
      {
        "command": "ohno.toggleAnnotations",
        "title": "Toggle Complexity Annotations",
        "category": "Oʰ(nᵒ)",
        "icon": "$(eye)"
      },
      {
        "command": "ohno.copyComplexity",
        "title": "Copy Complexity Summary",
        "category": "Oʰ(nᵒ)",
        "icon": "$(copy)"
      },
      {
        "command": "ohno.focusComplexity",
        "title": "Focus Complexity Panel",
        "category": "Oʰ(nᵒ)",
        "icon": "$(list-tree)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ohno",
          "title": "Complexity",
          "icon": "media/ohno-activity.svg"
        }
      ]
    },
    "views": {
      "ohno": [
        {
          "id": "ohno.summary",
          "name": "Summary",
          "contextualTitle": "Complexity"
        },
        {
          "id": "ohno.derivation",
          "name": "Derivation",
          "contextualTitle": "Complexity"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ohno.summary",
        "contents": "Open a C# file and place the cursor in a function to see its complexity analysis."
      },
      {
        "view": "ohno.derivation",
        "contents": "Derivation nodes appear here after a function is analyzed. Click a node to select its source range."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ohno.runDeepAnalysis",
          "when": "view == ohno.summary || view == ohno.derivation",
          "group": "navigation"
        },
        {
          "command": "ohno.copyComplexity",
          "when": "view == ohno.summary || view == ohno.derivation",
          "group": "navigation"
        }
      ]
    },
    "colors": [
      {
        "id": "ohno.inlineForeground",
        "description": "Foreground color of inline complexity annotations.",
        "defaults": {
          "dark": "#99999999",
          "light": "#66666699",
          "highContrast": "#cccccc",
          "highContrastLight": "#333333"
        }
      },
      {
        "id": "ohno.inlineBackground",
        "description": "Fallback background of inline complexity annotations.",
        "defaults": {
          "dark": "#80808033",
          "light": "#80808026",
          "highContrast": "#80808055",
          "highContrastLight": "#80808040"
        }
      },
      {
        "id": "ohno.inlineBackgroundHigh",
        "description": "Translucent background for high-confidence annotations.",
        "defaults": {
          "dark": "#4ec9b033",
          "light": "#16825d26",
          "highContrast": "#4ec9b055",
          "highContrastLight": "#16825d40"
        }
      },
      {
        "id": "ohno.inlineBackgroundMedium",
        "description": "Translucent background for medium-confidence annotations.",
        "defaults": {
          "dark": "#dcdcaa33",
          "light": "#795e2626",
          "highContrast": "#dcdcaa55",
          "highContrastLight": "#795e2640"
        }
      },
      {
        "id": "ohno.inlineBackgroundLow",
        "description": "Translucent background for low-confidence annotations.",
        "defaults": {
          "dark": "#ce917833",
          "light": "#a3151526",
          "highContrast": "#ce917855",
          "highContrastLight": "#a3151540"
        }
      },
      {
        "id": "ohno.inlineBackgroundUnknown",
        "description": "Translucent background when complexity is unknown.",
        "defaults": {
          "dark": "#80808033",
          "light": "#80808026",
          "highContrast": "#80808055",
          "highContrastLight": "#80808040"
        }
      },
      {
        "id": "ohno.inlineBackgroundNested",
        "description": "Translucent background of nested subtotal annotations.",
        "defaults": {
          "dark": "#80808028",
          "light": "#88888822",
          "highContrast": "#80808044",
          "highContrastLight": "#88888833"
        }
      },
      {
        "id": "ohno.confidenceHigh",
        "description": "Color used for high-confidence complexity results.",
        "defaults": {
          "dark": "#4ec9b0",
          "light": "#16825d",
          "highContrast": "#4ec9b0",
          "highContrastLight": "#16825d"
        }
      },
      {
        "id": "ohno.confidenceMedium",
        "description": "Color used for medium-confidence complexity results.",
        "defaults": {
          "dark": "#dcdcaa",
          "light": "#795e26",
          "highContrast": "#dcdcaa",
          "highContrastLight": "#795e26"
        }
      },
      {
        "id": "ohno.confidenceLow",
        "description": "Color used for low-confidence complexity results.",
        "defaults": {
          "dark": "#ce9178",
          "light": "#a31515",
          "highContrast": "#ce9178",
          "highContrastLight": "#a31515"
        }
      },
      {
        "id": "ohno.confidenceUnknown",
        "description": "Color used when complexity cannot be determined.",
        "defaults": {
          "dark": "#808080",
          "light": "#808080",
          "highContrast": "#808080",
          "highContrastLight": "#808080"
        }
      },
      {
        "id": "ohno.nestedForeground",
        "description": "Foreground color of nested subtotal complexity annotations (faded by depth).",
        "defaults": {
          "dark": "#80808080",
          "light": "#88888880",
          "highContrast": "#a0a0a0",
          "highContrastLight": "#606060"
        }
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:vscode": "node ../../scripts/e2e-vscode.mjs",
    "icons": "node ../../scripts/build-icons.mjs",
    "package": "vsce package --no-rewrite-relative-links",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "typescript": "^5.7.0",
    "vscode-jsonrpc": "^8.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "vitest": "^2.1.8"
  }
}
